# ── Required in production ─────────────────────────────────────────────────────

# Set to "production" on Railway. Controls CORS strictness, docs exposure, logging.
APP_ENV=production

# Comma-separated list of allowed frontend origins (no localhost in production).
# Example: https://cardoptimal.in,https://www.cardoptimal.in
ALLOWED_ORIGINS=https://cardoptimal.in,https://www.cardoptimal.in

# ── Optional overrides (defaults shown) ───────────────────────────────────────

# Data file paths (default: relative to repo root — works on Railway with bundled data)
# OFFERS_SNAPSHOT_PATH=data/generated/offers.snapshot.json
# METADATA_SNAPSHOT_PATH=data/generated/metadata.snapshot.json
# FACETS_SNAPSHOT_PATH=data/generated/facets.snapshot.json
# MANIFEST_PATH=data/generated/manifest.json
# FEATURE_FLAGS_PATH=data/config/feature_flags.json

# API contract version served in X-Contract-Version response header
# CONTRACT_VERSION=1.1

# Pagination limits
# DEFAULT_PAGE_LIMIT=20
# MAX_PAGE_LIMIT=100

# Cache TTLs in seconds
# META_CACHE_TTL=86400
# FLAGS_CACHE_TTL=300
# OFFERS_CACHE_TTL=600

# Rate limits (requests per window)
# RATE_LIMIT_GLOBAL=30
# RATE_LIMIT_GLOBAL_WINDOW=60
# RATE_LIMIT_SEARCH=5
# RATE_LIMIT_SEARCH_WINDOW=10

# Set to "true" if running behind a trusted reverse proxy (Railway ingress)
TRUST_PROXY_HEADERS=true
