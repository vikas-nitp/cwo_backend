APP_ENV=production
PORT=8000
ALLOWED_ORIGINS=https://cardwiseoffer.com,https://www.cardwiseoffer.com
OFFERS_SNAPSHOT_PATH=/app/data/generated/offers.snapshot.json
METADATA_SNAPSHOT_PATH=/app/data/generated/metadata.snapshot.json
MANIFEST_PATH=/app/data/generated/manifest.json
FACETS_SNAPSHOT_PATH=/app/data/generated/facets.snapshot.json
FEATURE_FLAGS_PATH=/app/data/config/feature_flags.json
BOOKING_WINDOW_DAYS=10
SUPPORTED_PLATFORMS=MAKEMYTRIP,CLEARTRIP
CONTRACT_VERSION=1.1
DEFAULT_PAGE_LIMIT=50
MAX_PAGE_LIMIT=100
META_CACHE_TTL=86400
FLAGS_CACHE_TTL=300
OFFERS_CACHE_TTL=600
RATE_LIMIT_GLOBAL=30
RATE_LIMIT_GLOBAL_WINDOW=60
RATE_LIMIT_SEARCH=5
RATE_LIMIT_SEARCH_WINDOW=10
TRUST_PROXY_HEADERS=false
