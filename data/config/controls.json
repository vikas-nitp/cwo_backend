{
  "_readme": "Master control file for CardOptimal product stack (backend + frontend). See CONTROLS.md at workspace root for the cross-system quick reference.",

  "platforms": {
    "supported": ["MAKEMYTRIP", "CLEARTRIP"],
    "available": ["MAKEMYTRIP", "CLEARTRIP", "IXIGO", "YATRA", "AIRINDIA", "INDIGO", "EASEMYTRIP", "PAYTM", "AKASA", "SPICEJET"],
    "_note": "Override 'supported' at deploy time with SUPPORTED_PLATFORMS env var (comma-separated). 'available' is documentation only — lists all sources with working adapters."
