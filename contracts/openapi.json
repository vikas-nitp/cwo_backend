    "/api/v1/offers": {
      "get": {
        "operationId": "offers_api_v1_offers_get",
        "parameters": [
          {
            "in": "query",
            "name": "bank",
            "required": false,
            "schema": {
              "items": {
                "type": "string"
              },
              "title": "Bank",
              "type": "array"
            }
          },
          {
            "in": "query",
            "name": "platform",
            "required": false,
            "schema": {
              "items": {
                "type": "string"
              },
              "title": "Platform",
              "type": "array"
            }
          },
          {
            "in": "query",
            "name": "payment_method",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "CREDIT",
                    "DEBIT",
                    "NO_CARD"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Payment Method"
            }
          },
          {
            "in": "query",
            "name": "booking_channel",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "WEB",
                    "APP",
                    "WEB_AND_APP"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Booking Channel"
            }
          },
          {
            "in": "query",
            "name": "category",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "const": "FLIGHT_DOMESTIC",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Category"
            }
          },
          {
            "in": "query",
            "name": "active_on",
            "required": false,
            "schema": {
              "format": "date",
              "title": "Active On",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "minimum": 1,
              "title": "Page",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OffersResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Offers",
        "tags": [
          "Offers"
        ]
      }
    },
