      "SearchRequest": {
        "properties": {
          "banks": {
            "items": {
              "type": "string"
            },
            "maxItems": 2,
            "title": "Banks",
            "type": "array"
          },
          "booking_amount": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Booking Amount"
          },
          "category": {
            "const": "FLIGHT_DOMESTIC",
            "default": "FLIGHT_DOMESTIC",
